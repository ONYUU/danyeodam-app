# preview/production: public HTTPS Supabase origin; no reserved/example/private host
NEXT_PUBLIC_SUPABASE_URL=
# preview/production: sb_publishable_... (preferred) or legacy anon JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# preview/production server only: sb_secret_... (preferred) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_RECRUIT_GATE=false
PUBLIC_SHARE_CREATION=false
PUBLIC_SHARE_PUBLICATION=false
BONUS_PACK_ISSUANCE_SCOPE=
BONUS_PACK_CURSOR_SECRET=
PUBLIC_APP_URL=
# All three are required in preview/production and must be deployment secrets.
COLLECTION_CURSOR_SECRET=
LOCATION_COMPLIANCE_CURSOR_SECRET=
ABUSE_HMAC_SECRET=
ACCOUNT_DELETION_RATE_LIMIT_SECRET=
ACCOUNT_DELETION_SUPPORT_URL=
PUBLIC_SUPPORT_URL=
ACCOUNT_DELETION_DEVELOPER_NAME=
# preview/production: exact mobile callback; local/E2E may use loopback HTTP
AUTH_EMAIL_REDIRECT_TO=danyeodam://auth/callback
CRON_SECRET=
