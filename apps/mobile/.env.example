# These values are public and bundled into the client. Never put secrets here.
# preview/production reject reserved, example, private, and documentation hosts.
APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
EXPO_PUBLIC_POLICY_ALLOWED_ORIGINS=
