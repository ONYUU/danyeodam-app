{
  "name": "@danyeodam/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node ./scripts/run-expo-doctor.mjs",
    "assets:assert": "node ./scripts/assert-brand-assets.mjs",
    "config:assert:production": "node ./scripts/assert-native-config.mjs",
    "export:production:verify": "node ./scripts/export-production.mjs",
    "release:public-config-sha256": "node ./scripts/compute-mobile-public-config-sha256.mjs",
    "eas-build-pre-install": "node ./scripts/assert-eas-release-gate.mjs",
    "release:preflight": "npm --prefix ../.. run verify:public-source && npm run check && npm run config:assert:production",
    "export:production": "npm run release:preflight && npm run export:production:verify",
    "release:build": "corepack npm run release:preflight && corepack npm --offline --prefix ../../tools/eas-cli run eas -- build --profile production --platform all",
    "check": "npm run typecheck && npm run lint && npm test && npm run doctor && npm run assets:assert"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "expo": "~57.0.15",
    "expo-build-properties": "~57.0.13",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.4",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.12",
    "expo-router": "~57.0.15",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "parse5": "8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/plist": "0.8.1",
    "@types/node": "24.13.3",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-babel-transformer": "0.84.5",
    "metro-cache": "0.84.5",
    "metro-cache-key": "0.84.5",
    "metro-config": "0.84.5",
    "metro-core": "0.84.5",
    "metro-file-map": "0.84.5",
    "metro-minify-terser": "0.84.5",
    "metro-resolver": "0.84.5",
    "metro-runtime": "0.84.5",
    "metro-source-map": "0.84.5",
    "metro-symbolicate": "0.84.5",
    "metro-transform-plugins": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "uuid": "11.1.1"
  }
}
