{
  "name": "@danyeodam/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "expo-doctor .",
    "assets:assert": "node ./scripts/assert-brand-assets.mjs",
    "config:assert:production": "node ./scripts/assert-native-config.mjs",
    "export:production:verify": "node ./scripts/export-production.mjs",
    "eas-build-pre-install": "node ./scripts/assert-eas-release-gate.mjs",
    "release:preflight": "npm --prefix ../.. run verify:public-source && npm run check && npm run config:assert:production",
    "export:production": "npm run release:preflight && npm run export:production:verify",
    "release:build": "npm run release:preflight && npx --yes eas-cli@21.8.0 build --profile production --platform all",
    "check": "npm run typecheck && npm run lint && npm test && npm run doctor && npm run assets:assert"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-file-system": "~57.0.4",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.10",
    "expo-router": "~57.0.13",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
