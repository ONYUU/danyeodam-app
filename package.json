{
  "name": "danyeodam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:check-public": "node scripts/check-public-repo-safety.mjs",
    "security:test-public": "node --test scripts/test-public-repo-safety.mjs",
    "verify:public-source": "npm run security:test-public && npm run security:check-public && npm test && npm run typecheck && npm run lint && npm run build",
    "api:test:auth-email-confirmation": "node scripts/test-auth-email-confirmation-e2e.mjs",
    "api:test:personal-card": "node scripts/test-personal-card-e2e.mjs",
    "api:test:share-retro": "node scripts/test-share-retro-e2e.mjs",
    "api:test:localized-read": "node scripts/test-localized-read-e2e.mjs",
    "api:test:location-compliance": "node scripts/test-location-compliance-e2e.mjs",
    "api:test:account-deletion": "node scripts/test-account-deletion-e2e.mjs",
    "api:test:reviewer-access": "node scripts/test-reviewer-access-e2e.mjs",
    "db:reset": "supabase db reset --local --yes",
    "db:test": "supabase test db --local",
    "db:test:concurrency": "node scripts/test-db-concurrency.mjs",
    "db:test:reviewer-concurrency": "node scripts/test-reviewer-fixture-concurrency.mjs",
    "db:test:reviewer-upgrade": "node scripts/test-reviewer-fixture-upgrade.mjs",
    "db:test:location-upgrade": "node scripts/test-location-compliance-upgrade.mjs",
    "db:test:account-deletion-upgrade": "node scripts/test-account-deletion-upgrade.mjs",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on error"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "pg": "8.22.0",
    "supabase": "2.113.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
